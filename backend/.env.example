APP_NAME=Nazi AI
APP_ENV=development
DATABASE_URL=sqlite:///./data/nazi_ai.db
FRONTEND_ORIGIN=http://127.0.0.1:5173

# LOCAL AI (recommended): install Ollama, then run `ollama pull qwen2.5:7b` in a terminal.
# Start Ollama and use these settings. No API key is required for loopback services.
AI_PROVIDER=ollama
AI_BASE_URL=http://127.0.0.1:11434/v1
AI_API_KEY=
AI_MODEL=qwen2.5:7b
AI_TIMEOUT_SECONDS=180

# CLOUD ALTERNATIVE:
# AI_PROVIDER=openai-compatible
# AI_BASE_URL=https://api.openai.com/v1
# AI_API_KEY=put-your-private-key-here
# AI_MODEL=your-model-name
