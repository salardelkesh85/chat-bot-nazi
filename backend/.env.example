APP_NAME=Nazi AI
APP_ENV=development
DATABASE_URL=sqlite:///./data/nazi_ai.db
FRONTEND_ORIGIN=http://127.0.0.1:5173

# OpenAI-compatible API configuration.
# Keep the real key in backend/.env only; never put it in frontend code or GitHub.
AI_PROVIDER=openai-compatible
AI_BASE_URL=https://api.openai.com/v1
AI_API_KEY=
AI_MODEL=
AI_TIMEOUT_SECONDS=90
